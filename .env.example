# Copy to .env.local. Bun and Next both load it.

# Signs session cookies. Production's value must not change, or everyone is
# signed out. Generate one with: openssl rand -base64 48
JWT_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never point these at production. Use a Neon branch, because migrations and
# anything you do locally will write to it.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Needed for image uploads.
BLOB_READ_WRITE_TOKEN=

# Optional. Without Upstash, rate limits are per server instance, which barely
# limits anything in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults to 7 days, in seconds.
SESSION_DURATION=604800

# Optional. Defaults to https://maarechet.vercel.app.
NEXT_PUBLIC_MAARECHET_URL=
